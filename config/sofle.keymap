#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    macros {
        // Macro: BT profile 1 + turn layer 0 ON
        bt1_layer0_on: bt1_layer0_on {
            label = "BT1_LAYER0_ON";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <
                &bt BT_SEL 0        // select Bluetooth profile 1
                &tog_off 1           // turn layer 0 ON
            >;
        };

        // Macro: BT profile 2 + turn layer 1 ON
        bt2_layer1_on: bt2_layer1_on {
            label = "BT2_LAYER1_ON";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <
                &bt BT_SEL 1        // select Bluetooth profile 2
                &tog_on 1           // turn layer 1 ON
            >;
        };

        // Browser Controls
        tab_right: tab_right {
            label = "TAB_RIGHT";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings
                = <&macro_press   &kp LCTRL>
                , <&macro_tap     &kp TAB>
                , <&macro_release &kp LCTRL>;
        };
        tab_left: tab_left {
            label = "TAB_LEFT";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings
                = <&macro_press   &kp LCTRL &kp LSHFT>
                , <&macro_tap     &kp TAB>
            , <&macro_release &kp LCTRL &kp LSHFT>;
        };
        close_tab: close_tab {
        label = "CLOSE_TAB";
        compatible = "zmk,behavior-macro";
        #binding-cells = <0>;
        wait-ms = <0>;
        tap-ms = <0>;
        bindings
            = <&macro_press   &kp LCTRL>
            , <&macro_tap     &kp W>
            , <&macro_release &kp LCTRL>;
        };
    };
};
// Mod Morphs, Encoder, Tap-Dances
/ {
    behaviors {

    alt_d_macro: alt_d_macro {
            compatible = "zmk,behavior-macro";
            label = "ALT_D_MACRO";
            #binding-cells = <0>;

            bindings =
                <&macro_press   &kp LALT>,
                <&macro_tap     &kp D>,
                <&macro_release &kp LALT>;
        };
    
    d_ctrl_morph: d_ctrl_morph {
            compatible = "zmk,behavior-mod-morph";
            label = "D_CTRL_MORPH";
            #binding-cells = <0>;

            mods = <(MOD_LCTL | MOD_RCTL)>;
            bindings = <&kp D>, <&alt_d_macro>;
        };
    
    // Toggle Layer ON only
    tog_on: toggle_layer_on_only {
        compatible = "zmk,behavior-toggle-layer";
        #binding-cells = <1>;      // layer number
        display-name = "Toggle Layer On";
        toggle-mode = "on";        // only turns layer ON
        locking;
    };

    // Toggle Layer OFF only
    tog_off: toggle_layer_off_only {
        compatible = "zmk,behavior-toggle-layer";
        #binding-cells = <1>;      // layer number
        display-name = "Toggle Layer Off";
        toggle-mode = "off";       // only turns layer OFF
        locking;
    };

    // Mod Morph
    // RGB
        rgb_bri_sat_inc: rgb_bri_sat_inc {
            compatible = "zmk,behavior-mod-morph";
            label = "RGB_BRIGHTNESS_SATURATION_INCREASE";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_SAI>, <&rgb_ug RGB_BRI>;
            mods = <(MOD_LALT|MOD_RALT)>;
        };
        rgb_bri_sat_dec: rgb_bri_sat_dec {
            compatible = "zmk,behavior-mod-morph";
            label = "RGB_BRIGHTNESS_SATURATION_DECREASE";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_SAD>, <&rgb_ug RGB_BRD>;
            mods = <(MOD_LALT|MOD_RALT)>;
        };
        rgb_inc: rgb_inc {
            compatible = "zmk,behavior-mod-morph";
            label = "RGB_INCREASE";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_HUI>, <&rgb_bri_sat_inc>;
            mods = <(MOD_LSFT|MOD_RSFT|MOD_LCTL|MOD_RCTL)>;
        };
        rgb_dec: rgb_dec {
            compatible = "zmk,behavior-mod-morph";
            label = "RGB_DECREASE";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_HUD>, <&rgb_bri_sat_dec>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        // Encoder
        rgb_encoder: rgb_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            label = "RGB_ENCODER";
            #sensor-binding-cells = <0>;
            bindings = <&rgb_inc>, <&rgb_dec>;
        };
        tab_browser: tab_browser {
            compatible = "zmk,behavior-sensor-rotate";
            label = "TAB_BROWSER";
            #sensor-binding-cells = <0>;
            bindings = <&tab_left>, <&tab_right>;
        };
        // Config 
        td_btr: td_btr {
            compatible = "zmk,behavior-tap-dance";
            label = "TAP_DANCE_BLUE_TOOTH_RELEASE";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp ESC>, <&bt BT_CLR>;
        };
        td_ll_l3: td_ll_l3 {
            compatible = "zmk,behavior-tap-dance";
            label = "TAP_LEFT_LAYER_LAYER_3";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mo 3>, <&sl 3>;
        };
        td_rl_l3: td_rl_l3 {
            compatible = "zmk,behavior-tap-dance";
            label = "TAP_RIGHT_LAYER_LAYER_3";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mo 4>, <&sl 3>;
        };
        // Mac - Windows shortcuts 
        switch_lang_windows_caps: switch_lang_windows_caps {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <
                &macro_press   &kp LALT
                &macro_press   &kp LSHIFT
                &macro_release &kp LSHIFT
                &macro_release &kp LALT
            >;
        };
    };
    keymap {
        compatible = "zmk,keymap";

        default_layer {
// ------------------------------------------------------------------------------------------------------------
// | ESC  |  1  |  2  |  3   |  4   |  5   |                    |  6   |  7   |  8   |  9   |  0   | Del   |
// | Tab  |  Q  |  W  |  E   |  R   |  T   |                    |  Y   |  U   |  I   |  O   |  P   | Bksp |
// | Caps |  A  |  S  |  D   |  F   |  G   |                    |  H   |  J   |  K   |  L   |  ;   |  '   |
// |Shift |  Z  |  X  |  C   |  V   |  B   | CloseTab |   | Mute  |  N   |  M   |  ,   |  .   |  /   |Shift |
//               | Ctrl | Alt | GUI | lower | Space |        | Enter | Raise | Ctrl | Alt | GUI |
            display-name = "Mac";
            bindings = <
&kp ESC &kp N1 &kp N2     &kp N3   &kp N4    &kp N5                             &kp N6     &kp N7    &kp N8    &kp N9   &kp N0   &kp DEL
&kp TAB &kp Q  &kp W      &kp E    &kp R     &kp T                              &kp Y      &kp U     &kp I     &kp O    &kp P    &kp BSPC
&kp CLCK   &kp A  &kp S      &kp D    &kp F     &kp G                              &kp H      &kp J     &kp K     &kp L    &kp SEMI &kp SQT
&kp LSHIFT   &kp Z  &kp X      &kp C    &kp V     &kp B &close_tab &kp C_MUTE  &kp N      &kp M     &kp COMMA &kp DOT  &kp FSLH &kp RSHIFT
                 &kp LCTRL &kp LALT &kp LGUI   &td_ll_l3 &kp SPACE &kp RET     &td_rl_l3    &kp RCTRL &kp RALT  &kp RGUI
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &tab_browser>;
        };

        windows_layer {
// ------------------------------------------------------------------------------------------------------------
// | ESC  |  1  |  2  |  3   |  4   |  5   |                    |  6   |  7   |  8   |  9   |  0   | Del   |
// | Tab  |  Q  |  W  |  E   |  R   |  T   |                    |  Y   |  U   |  I   |  O   |  P   | Bksp |
// | Lang |  A  |  S  |  D   |  F   |  G   |                    |  H   |  J   |  K   |  L   |  ;   |  '   |
// |Shift |  Z  |  X  |  C   |  V   |  B   | CloseTab |   | Mute  |  N   |  M   |  ,   |  .   |  /   |Shift |
//               | GUI | Alt | Ctrl | lower | Space |       | Enter | Raise | Ctrl | Alt | GUI |
            display-name = "Windows";
            bindings = <
&kp ESC &kp N1 &kp N2     &kp N3   &kp N4    &kp N5                             &kp N6     &kp N7    &kp N8    &kp N9   &kp N0   &kp DEL
&kp TAB &kp Q  &kp W      &kp E    &kp R     &kp T                              &kp Y      &kp U     &kp I     &kp O    &kp P    &kp BSPC
&switch_lang_windows_caps   &kp A  &kp S      &d_ctrl_morph    &kp F     &kp G                              &kp H      &kp J     &kp K     &kp L    &kp SEMI &kp SQT
&kp LSHIFT   &kp Z  &kp X      &kp C    &kp V     &kp B &close_tab &kp C_MUTE  &kp N      &kp M     &kp COMMA &kp DOT  &kp FSLH &kp RSHIFT
                &kp LGUI &kp LALT &kp LCTRL  &td_ll_l3 &kp SPACE &kp RET     &td_rl_l3 &kp RCTRL &kp RALT  &kp RGUI
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &tab_browser>;
        };

    gaming {
// ------------------------------------------------------------------------------------------------------------
// | ESC  |  1  |  2  |  3   |  4   |  5   |                    |  6   |  7   |  8   |  9   |  0   | Del   |
// | Tab  |  Q  |  W  |  E   |  R   |  T   |                    |  Y   |  U   |  I   |  O   |  P   | Bksp |
// | Caps |  A  |  S  |  D   |  F   |  G   |                    |  H   |  J   |  K   |  L   |  ;   |  '   |
// |Shift |  Z  |  X  |  C   |  V   |  B   | CloseTab |   | Mute  |  N   |  M   |  ,   |  .   |  /   |Shift |
//               | GUI | Alt | Ctrl | Space | lower |        | Enter | Raise | Ctrl | Alt | GUI |
            display-name = "Gaming";
            bindings = <
&kp ESC &kp N1 &kp N2     &kp N3   &kp N4    &kp N5                             &kp N6     &kp N7    &kp N8    &kp N9   &kp N0   &kp DEL
&kp TAB &kp Q  &kp W      &kp E    &kp R     &kp T                              &kp Y      &kp U     &kp I     &kp O    &kp P    &kp BSPC
&kp CLCK   &kp A  &kp S      &kp D    &kp F     &kp G                              &kp H      &kp J     &kp K     &kp L    &kp SEMI &kp SQT
&kp LSHIFT   &kp Z  &kp X      &kp C    &kp V     &kp B &close_tab &kp C_MUTE  &kp N      &kp M     &kp COMMA &kp DOT  &kp FSLH &kp RSHIFT
                &kp LGUI &kp LALT &kp LCTRL  &kp SPACE &td_ll_l3 &td_rl_l3 &kp RET  &kp RCTRL &kp RALT  &kp RGUI
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &tab_browser>;
        };

        lower_layer {
// ------------------------------------------------------------------------------------------------------------
// | BTClr | BT1  | BT2  | BT3  | BT4  | BT5  |                    | Hue+ |  =   |  /   |  *   |  -   | Eff+ |
// | B+    | Prt  | Ins  |  ↑   |  @   |  %   |                    | Hue- |  7   |  8   |  9   |  +   | Bksp |
// | B-    | RGB  |  ←   |  ↓   |  →   |  $   |                    | Sat+ |  4   |  5   |  6   |  +   | Spd+ |
// |Task   | USB  |      | Prev | Next |  #   | PL/PS |     |      | Sat- |  1   |  2   |  3   | Enter | Spd- |
//                |      |       |       |      |      |        |       |  0   | Ctrl | Alt | GUI |
            display-name = "Lower";
            bindings = <
&td_btr         &bt1_layer0_on    &bt2_layer1_on  &bt BT_SEL 2  &bt BT_SEL 3 &bt BT_SEL 4                       &rgb_ug RGB_HUI &kp KP_EQUAL &kp KP_DIVIDE &kp KP_MULTIPLY &kp KP_MINUS &rgb_ug RGB_EFF
&rgb_ug RGB_BRI &kp PSCRN       &kp INS      &kp UP        &kp AT       &kp PRCNT                          &rgb_ug RGB_HUD &kp N7       &kp N8        &kp N9          &kp KP_PLUS  &trans
&rgb_ug RGB_BRD &rgb_ug RGB_TOG &kp LEFT     &kp DOWN      &kp RIGHT    &kp DLLR                           &rgb_ug RGB_SAI &kp N4       &kp N5        &kp N6          &kp KP_PLUS  &rgb_ug RGB_SPI
&trans            &out OUT_TOG    &trans       &kp C_PREV    &kp C_NEXT   &kp HASH   &trans &kp C_PLAY_PAUSE  &rgb_ug RGB_SAD &kp N1       &kp N2        &kp N3          &kp KP_ENTER &rgb_ug RGB_SPD
                                &trans       &trans        &trans       &trans    &trans            &kp BSPC &kp N0          &kp RCTRL &kp RALT  &kp RGUI 
            >;

            sensor-bindings = <&inc_dec_kp C_FAST_FORWARD C_REWIND &inc_dec_kp UP DOWN>;
        };

        raise_layer {
// ------------------------------------------------------------------------------------------------------------
// | F1   | F2   | F3   | F4   | F5   | F6   |                    | F7   | F8   | F9   | F10  | F11  | F12  |
// |Boot  |  `   |  ~   |  <   |  >   |  ?   |                    |  *   |  {   |  }   | Home | End  |      |
// |      |  !   |  @   |  #   |  $   |  %   |                    |  _   |  (   |  )   |  ;   |  |   |Color |
// |      |  =   |  -   |  +   |  &   |  |   | RGB    |       |      | ^    |  [   |  ]   |  :   |  \   | Power |
//               | Tog2 | Tog1 |      | Mo3  |        |       |       | Ctrl | Alt  | GUI |
            display-name = "Raise";            
bindings = <
&kp F1    &kp F2    &kp F3    &kp F4      &kp F5    &kp F6                              &kp F7    &kp F8    &kp F9    &kp F10   &kp F11   &kp F12
&bootloader    &kp GRAVE &kp TILDE &kp LT      &kp GT    &kp QMARK                           &kp ASTRK &kp LBRC  &kp RBRC  &kp HOME  &kp END   &trans
&trans    &kp EXCL  &kp AT    &kp HASH    &kp DLLR  &kp PRCNT                           &kp UNDER &kp LPAR  &kp RPAR  &kp SEMI  &kp PIPE  &trans
&trans    &kp EQUAL &kp MINUS &kp KP_PLUS &kp AMPS  &kp PIPE     &trans &rgb_ug RGB_TOG  &kp CARET &kp LBKT  &kp RBKT  &kp COLON &kp BSLH  &bootloader
                    &tog 2    &tog 1    &trans    &mo 3     &trans           &trans  &trans    &kp RCTRL &kp RALT  &kp RGUI
            >;

            sensor-bindings = <&rgb_encoder &inc_dec_kp C_BRI_INC C_BRI_DEC>;
        };
    };
};
